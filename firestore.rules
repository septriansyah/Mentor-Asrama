rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // CATATAN KEAMANAN: Login admin & mentor di aplikasi ini masih pengecekan sisi klien saja
    // (BUKAN Firebase Authentication), jadi request.auth di sini akan SELALU null. Aturan di bawah
    // sengaja dibuka (read/write: if true) supaya aplikasi tetap berfungsi - artinya siapa pun yang
    // tahu konfigurasi Firebase (yang memang publik ada di bundle client) bisa baca/tulis data ini.
    // Untuk keamanan sungguhan, pasang Firebase Authentication lalu ganti "if true" di bawah
    // menjadi "if request.auth != null" (atau custom claim admin).

    match /siswa/{siswaId} {
      allow read, write: if true;
    }

    match /indikator/{indikatorId} {
      allow read, write: if true;
    }

    match /penilaian/{penilaianId} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
