{
  "entities": {
    "Siswa": {
      "title": "Siswa",
      "description": "Dokumen data siswa (Mentor & Mentee)",
      "type": "object",
      "properties": {
        "nama": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["Mentor", "Mentee"] },
        "angkatan": { "type": "number" },
        "kamar": { "type": "string", "maxLength": 20, "description": "Nomor kamar fisik" },
        "gedung": { "type": "string", "maxLength": 50 },
        "lantai": { "type": "number" },
        "kelompok": { "type": "string", "maxLength": 20, "description": "Unik per gedung+lantai, bukan unik global" },
        "prioritasSekamar": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nama", "status", "angkatan", "kamar", "gedung", "lantai", "kelompok", "prioritasSekamar"]
    },
    "Indikator": {
      "title": "Indikator",
      "description": "Indikator penilaian yang dikelola admin (jumlah tidak dibatasi)",
      "type": "object",
      "properties": {
        "urutan": { "type": "number" },
        "nama": { "type": "string", "maxLength": 100 },
        "deskripsi": { "type": "string", "maxLength": 500 },
        "opsiNilai": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "score": { "type": "number" }
            }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["urutan", "nama", "deskripsi"]
    },
    "Penilaian": {
      "title": "Penilaian",
      "description": "Penilaian satu mentee untuk satu bulan tertentu (satu mentee bisa punya beberapa dokumen, satu per bulan)",
      "type": "object",
      "properties": {
        "siswaId": { "type": "string", "maxLength": 128 },
        "bulan": { "type": "string", "enum": ["September", "Oktober", "November", "Desember"] },
        "kamar": { "type": "string", "maxLength": 20 },
        "nilai": { "type": "object", "description": "Map urutan indikator -> skor 0-100" },
        "diisiOleh": { "type": "string", "maxLength": 100 },
        "lengkap": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["siswaId", "bulan", "kamar", "nilai", "diisiOleh", "lengkap"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Dokumen pengaturan tunggal (id: openMonths) - bulan penilaian yang dibuka admin untuk mentor",
      "type": "object",
      "properties": {
        "months": {
          "type": "array",
          "items": { "type": "string", "enum": ["September", "Oktober", "November", "Desember"] }
        }
      }
    }
  },
  "firestore": {
    "/siswa/{siswaId}": {
      "schema": "Siswa",
      "description": "Data master mentor dan mentee"
    },
    "/indikator/{indikatorId}": {
      "schema": "Indikator",
      "description": "Indikator penilaian dikelola admin"
    },
    "/penilaian/{penilaianId}": {
      "schema": "Penilaian",
      "description": "penilaianId = `${siswaId}__${bulan}`, satu dokumen per mentee per bulan"
    },
    "/settings/openMonths": {
      "schema": "Settings",
      "description": "Kontrol bulan mana yang boleh diisi mentor"
    }
  }
}
